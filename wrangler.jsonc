{
  // Cloudflare Workers Builds 로 배포할 때 읽는 설정.
  // main 을 두지 않는 **정적 자산 전용 워커**다. dist 를 그대로 올린다.
  // ★Cloudflare Pages 로 붙일 거면 이 파일은 쓰이지 않는다(대시보드 설정이 이긴다).
  "name": "maruon",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist",
    // 없는 주소는 dist/404.html 을 보여 준다. 그 쪽은 noindex 로 찍혀 있다.
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true }
}
